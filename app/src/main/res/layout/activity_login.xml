<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/loginToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0D1117"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <ScrollView
        android:id="@+id/logContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF58A6FF"
                android:textSize="15sp"
                android:text="准备就绪" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textColor="#FFC9D1D9"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_intro"
                android:textColor="#FFC9D1D9"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Google 邮箱 *"
                android:textColor="#FF8B949E" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="you@gmail.com"
                android:inputType="textEmailAddress"
                android:textColor="#FFC9D1D9"
                android:textColorHint="#FF484F58" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="密码 *"
                android:textColor="#FF8B949E" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Google 账号密码"
                android:inputType="textPassword"
                android:textColor="#FFC9D1D9"
                android:textColorHint="#FF484F58" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TOTP 密钥（可选，标准 2FA）"
                android:textColor="#FF8B949E" />

            <EditText
                android:id="@+id/etTotp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="JBSWY3DPEHPK3PXP"
                android:inputType="textVisiblePassword"
                android:textColor="#FFC9D1D9"
                android:textColorHint="#FF484F58" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="恢复邮箱（可选）"
                android:textColor="#FF8B949E" />

            <EditText
                android:id="@+id/etRecovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="backup@example.com"
                android:inputType="textEmailAddress"
                android:textColor="#FFC9D1D9"
                android:textColorHint="#FF484F58" />

            <Button
                android:id="@+id/btnStartLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="开始自动登录" />

            <Button
                android:id="@+id/btnVncLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="改为 VNC 手动登录（短信/验证码/Passkey 均可）" />

            <Button
                android:id="@+id/btnImportAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="@string/import_auth_button"
                android:textColor="#FF58A6FF" />

            <Button
                android:id="@+id/btnCancelLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="终止登录任务"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
