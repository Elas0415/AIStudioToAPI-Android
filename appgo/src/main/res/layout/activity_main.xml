<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0D1117"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#FFFFFFFF">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/loadingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="正在启动本地服务..."
                    android:textColor="#FF333333" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!--
      浏览器登录窗口：控制台里点「浏览器登录」时覆盖整个界面，显示后端 Camoufox
      所在的虚拟桌面（noVNC）。

      结构刻意保持"应用栏 + 整屏浏览器"两段：
        * 应用栏高度 = @dimen/login_bar_height，而 RuntimeEnv 正是用这个值把虚拟
          桌面设成"屏幕高 - 应用栏"，所以下面的 noVNC 视图和远端 framebuffer 尺寸
          完全一致 -> 1:1 铺满，既没有黑边也不会缩放糊掉。
        * 所有操作（适配 / 输入文本 / 重连 / 返回界面）都在应用栏的溢出菜单里，
          不再占用浏览器区域。
    -->
    <LinearLayout
        android:id="@+id/loginOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/loginToolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/login_bar_height"
            android:background="#0D1117"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        <!-- Two-finger zoom lives here (noVNC swallows the WebView's own pinch). -->
        <com.aistudio2api.launcher.PinchZoomLayout
            android:id="@+id/vncZoom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FF000000">

            <WebView
                android:id="@+id/vncWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.aistudio2api.launcher.PinchZoomLayout>
    </LinearLayout>

</FrameLayout>
